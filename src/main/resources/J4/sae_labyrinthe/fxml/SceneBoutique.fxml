<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="J4.sae_labyrinthe.controleur.SceneBoutiqueControleur">

    <!-- Section Argent en haut -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" BorderPane.alignment="CENTER">
            <ImageView fx:id="iconCoin"
                       fitWidth="40"
                       fitHeight="40"
                       pickOnBounds="true"
                       preserveRatio="true">
                <image>
                    <Image url="@../assets/icons/coins.png"/>
                </image>
            </ImageView>

            <Text fx:id="txtArgent"
                  text="0"
                  style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- Liste des boutons de la boutique -->
    <center>
        <VBox spacing="20" alignment="CENTER">
            <Button text="Acheter boussole"
                    prefWidth="250"
                    style="-fx-font-size: 18px;"
            />

            <Button text="Acheter téléportation"
                    prefWidth="250"
                    style="-fx-font-size: 18px;"
                    />

            <Button text="Acheter vision"
                    prefWidth="250"
                    style="-fx-font-size: 18px;"
                    />

            <Button text="Retour"
                    prefWidth="200"
                    style="-fx-font-size: 16px;"
                    onMouseClicked="#retourScenePrecendente"
                    />
        </VBox>
    </center>

    <padding>
        <Insets top="30" bottom="30" left="40" right="40"/>
    </padding>

</BorderPane>
