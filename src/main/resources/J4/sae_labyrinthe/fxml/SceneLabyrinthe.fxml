<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="zoneGlobale" stylesheets="@../css/styleLaby.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="J4.sae_labyrinthe.controleur.SceneLabyrintheControleur">
   <children>
      <BorderPane>
         <top>
            <HBox fx:id="enteteJeu" alignment="CENTER_RIGHT" prefHeight="50.0" prefWidth="1280.0" spacing="50.0" BorderPane.alignment="CENTER">
                <padding>
                    <Insets bottom="30" />
                </padding>
                <children>
                  <Text fx:id="info1" strokeType="OUTSIDE" strokeWidth="0.0" />
                  <Text fx:id="info2" strokeType="OUTSIDE" strokeWidth="0.0" />
                  <Text fx:id="info3" strokeType="OUTSIDE" strokeWidth="0.0" />
                  <Text fx:id="timerInfo" strokeType="OUTSIDE" strokeWidth="0.0" text="Timer : " />
                    <Button fx:id="btnPause" text="Pause" mnemonicParsing="false" onMouseClicked="#afficherMenuPause">
                        <padding>
                            <Insets top="5" right="10" bottom="5" left="10"/>
                        </padding>
                    </Button>
               </children>
               <BorderPane.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </BorderPane.margin>
            </HBox>
         </top>
         <center>
            <StackPane fx:id="zoneLaby" BorderPane.alignment="CENTER">
               <BorderPane.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </BorderPane.margin>
            </StackPane>
         </center>
      </BorderPane>
   </children>
</StackPane>
