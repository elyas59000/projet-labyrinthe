<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="J4.sae_labyrinthe.controleur.SceneContreLaMontreControleur">

    <top>
        <Text text="Mode Contre-la-montre"
              style="-fx-font-size: 32px; -fx-font-weight: bold;"
              BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <Text fx:id="txtDescription"
              text="Complète le labyrinthe avant la fin du chrono !"
              style="-fx-font-size: 18px;"/>

        <VBox spacing="25" alignment="CENTER">

            <Text text="Complète le labyrinthe avant la fin du chrono !"
                  style="-fx-font-size: 18px;"/>

            <Button text="Jouer"
                    prefWidth="250"
                    style="-fx-font-size: 18px;"
                    onMouseClicked="#jouerContreLaMontre"/>

            <Button text="Retour"
                    prefWidth="200"
                    style="-fx-font-size: 16px;"
                    onMouseClicked="#revenirMenu"/>
        </VBox>
    </center>

    <padding>
        <Insets top="40" bottom="40" left="40" right="40"/>
    </padding>

</BorderPane>
